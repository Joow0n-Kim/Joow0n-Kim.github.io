---
import { PROFILE } from "../config";
const links = [
  {
    label: "Email",
    text: `Email: ${PROFILE.email}`,
    url: `mailto:${PROFILE.email}`,
    path: "M20 4H4c-1.103 0-2 .897-2 2v12c0 1.103.897 2 2 2h16c1.103 0 2-.897 2-2V6c0-1.103-.897-2-2-2zm0 2v.511l-8 6.223-8-6.222V6h16zM4 18V9.044l7.386 5.745a.994.994 0 0 0 1.228 0L20 9.044 20.002 18H4z",
  },
  {
    label: "Google Scholar",
    text: "Google Scholar",
    url: PROFILE.scholar,
    path: "M5.242 13.769 0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z",
  },
  {
    label: "GitHub",
    text: "GitHub",
    url: PROFILE.github,
    path: "M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z",
  },
  {
    label: "LinkedIn",
    text: "LinkedIn",
    url: PROFILE.linkedin,
    path: "M9.237 8.855v12.139h3.769v-6.003c0-1.584.298-3.118 2.262-3.118 1.937 0 1.961 1.811 1.961 3.218v5.904H21v-6.657c0-3.27-.704-5.783-4.526-5.783-1.835 0-3.065 1.007-3.568 1.96h-.051v-1.66H9.237zm-6.142 0H6.87v12.139H3.095zM4.983 2.821a2.188 2.188 0 1 0 0 4.376 2.188 2.188 0 0 0 0-4.376z",
  },
];
---

<div class="contact-links flex flex-wrap items-center gap-x-5 gap-y-2 mt-4 text-[0.95rem]">
    {
        links.map((l) => (
            <a href={l.url} target={l.url.startsWith("mailto:") ? undefined : "_blank"} rel="noopener" class="inline-flex items-center gap-1.5 text-base-content/80 hover:text-base-content" aria-label={l.label}>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" style="fill: currentColor;" aria-hidden="true">
                    <path d={l.path} />
                </svg>
                <span>{l.text}</span>
            </a>
        ))
    }
</div>
